PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/aura-of-nature
# Atlas SRV (needs working DNS SRV lookup):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/aura-of-nature?retryWrites=true&w=majority
# Atlas standard (no SRV — use if you see querySrv ECONNREFUSED):
# MONGODB_URI=mongodb://USER:PASSWORD@shard-host-00:27017,shard-host-01:27017,shard-host-02:27017/aura-of-nature?ssl=true&replicaSet=atlas-xxx-shard-0&authSource=admin
JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Aura of Nature <noreply@auraofnature.local>
