PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/aura-of-nature
# Atlas:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/aura-of-nature?retryWrites=true&w=majority

# REQUIRED in production — long random string (never use the default)
JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRES_IN=7d

CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174,https://www.auraofnature.com,https://auraofnature.com
# Storefront URL used in password-reset / order emails — use the LIVE site in any env that sends real mail
CLIENT_URL=https://www.auraofnature.com
# PUBLIC_API_URL=https://your-api.onrender.com

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# REQUIRED in production for online payments (fail-closed without these)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signing secret from Razorpay Dashboard → Webhooks
# Endpoint: POST /api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=

# REQUIRED in production (order + contact emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Aura of Nature <noreply@auraofnature.local>

INSTAGRAM_USERNAME=auraofnatureofficial
