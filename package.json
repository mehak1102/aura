{
  "name": "aura-of-nature",
  "version": "1.0.0",
  "private": true,
  "description": "Luxury skincare & wellness ecommerce platform",
  "workspaces": [
    "client",
    "admin",
    "server",
    "e2e"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=client",
    "dev:client": "npm run dev --workspace=client",
    "dev:admin": "npm run dev --workspace=admin",
    "dev:server": "npm run dev --workspace=server",
    "dev:all": "npm run dev --workspace=server & npm run dev --workspace=client & npm run dev --workspace=admin",
    "build": "npm run build --workspace=client && npm run build --workspace=admin && npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "build:admin": "npm run build --workspace=admin",
    "build:server": "npm run build --workspace=server",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspace=@aura/e2e",
    "test:e2e": "npm run test --workspace=@aura/e2e",
    "test:api": "npm run test:api --workspace=@aura/e2e",
    "test:storefront": "npm run test:storefront --workspace=@aura/e2e",
    "test:admin": "npm run test:admin --workspace=@aura/e2e",
    "test:report": "npm run report --workspace=@aura/e2e"
  },
  "engines": {
    "node": ">=20"
  }
}
